/* =========================================================================
   zero-player — Cold-blue "command center" theme
   Tokens: bg-root #0B0F14 · panel #121821 · elevated #18202B · input #0E141B
           border #232D3A · border-strong #2E3A49
           text #E6EDF3 · text2 #9AA7B6 · muted #5F6B7A
           accent #2F81F7 · accent2 #22B8CF
           success #2ECC71 · warning #E3B341 · danger #F85149
   ========================================================================= */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    outline: none;
}

QWidget {
    color: #E6EDF3;
    font-size: 13px;
}

QToolTip {
    background: #18202B;
    color: #E6EDF3;
    border: 1px solid #2E3A49;
    padding: 4px 8px;
    border-radius: 6px;
}

/* ---------------- Login ---------------- */

QWidget#LoginRoot {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0B0F14, stop:0.55 #0C1620, stop:1 #0E2233);
}

QFrame#LoginCard {
    background: #121821;
    border: 1px solid #232D3A;
    border-radius: 14px;
}

QWidget#BrandPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(47,129,247,0.16), stop:1 rgba(34,184,207,0.08));
    border-top-left-radius: 14px;
    border-bottom-left-radius: 14px;
    border-right: 1px solid #1B2531;
}

QLabel#BrandLogo { color: #2F81F7; font-size: 34px; font-weight: 700; }
QLabel#BrandName { color: #E6EDF3; font-size: 26px; font-weight: 700; letter-spacing: 1px; }
QLabel#BrandTagline { color: #9AA7B6; font-size: 13px; }
QLabel#BrandFeature { color: #9AA7B6; font-size: 13px; }
QLabel#BrandVersion { color: #5F6B7A; font-size: 11px; }

QWidget#FormPanel {
    background: transparent;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
}
QLabel#FormTitle { color: #E6EDF3; font-size: 20px; font-weight: 600; }
QLabel#FormSubtitle { color: #9AA7B6; font-size: 12px; }
QLabel#FieldLabel { color: #9AA7B6; font-size: 12px; }

QLineEdit#LoginInput {
    background: #0E141B;
    border: 1px solid #232D3A;
    border-radius: 8px;
    padding: 9px 12px;
    color: #E6EDF3;
    selection-background-color: #2F81F7;
}
QLineEdit#LoginInput:hover { border-color: #2E3A49; }
QLineEdit#LoginInput:focus { border: 1px solid #2F81F7; background: #0B1118; }

QPushButton#LoginButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2F81F7, stop:1 #2C6FE0);
    color: #FFFFFF;
    border: none;
    border-radius: 9px;
    padding: 11px 16px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#LoginButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3E8DFF, stop:1 #3A7BEC);
}
QPushButton#LoginButton:pressed { background: #2A66CC; }
QPushButton#LoginButton:disabled { background: #223047; color: #7F8B99; }

QLabel#ErrorLabel { color: #F85149; font-size: 12px; min-height: 16px; }

QToolButton#WinClose {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #9AA7B6;
    font-size: 16px;
}
QToolButton#WinClose:hover { background: #F85149; color: #FFFFFF; }

QCheckBox { color: #9AA7B6; spacing: 7px; }
QCheckBox::indicator {
    width: 15px; height: 15px;
    border: 1px solid #2E3A49;
    border-radius: 4px;
    background: #0E141B;
}
QCheckBox::indicator:hover { border-color: #2F81F7; }
QCheckBox::indicator:checked {
    background: #2F81F7;
    border-color: #2F81F7;
    image: none;
}

/* ---------------- Player window ---------------- */

QMainWindow#PlayerWindow { background: #0B0F14; }
QWidget#RootArea { background: #0B0F14; }

QWidget#TopBar {
    background: #121821;
    border-bottom: 1px solid #232D3A;
}
QLabel#AppLogo { color: #2F81F7; font-size: 22px; font-weight: 700; }
QLabel#AppName { color: #E6EDF3; font-size: 16px; font-weight: 700; letter-spacing: 0.5px; }
QLabel#GroupChip {
    color: #9AA7B6;
    background: #0E141B;
    border: 1px solid #232D3A;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
}

QLineEdit#SearchBox {
    background: #0E141B;
    border: 1px solid #232D3A;
    border-radius: 8px;
    padding: 7px 12px;
    color: #E6EDF3;
    selection-background-color: #2F81F7;
}
QLineEdit#SearchBox:focus { border-color: #2F81F7; }

QToolButton#LayoutBtn {
    background: #0E141B;
    border: 1px solid #232D3A;
    border-radius: 7px;
    color: #9AA7B6;
    padding: 6px 10px;
    font-size: 12px;
}
QToolButton#LayoutBtn:hover { border-color: #2E3A49; color: #E6EDF3; }
QToolButton#LayoutBtn:checked {
    background: rgba(47,129,247,0.16);
    border: 1px solid #2F81F7;
    color: #CFE1FF;
    font-weight: 600;
}

QToolButton#UserBtn {
    background: #0E141B;
    border: 1px solid #232D3A;
    border-radius: 16px;
    color: #E6EDF3;
    padding: 6px 14px;
}
QToolButton#UserBtn:hover { border-color: #2F81F7; }
QToolButton#UserBtn::menu-indicator { image: none; }

QMenu {
    background: #18202B;
    border: 1px solid #2E3A49;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item { padding: 7px 18px; border-radius: 6px; color: #E6EDF3; }
QMenu::item:selected { background: rgba(47,129,247,0.20); }
QMenu::separator { height: 1px; background: #232D3A; margin: 5px 8px; }

/* ---------------- Panels ---------------- */

QWidget#SidePanel {
    background: #121821;
}
QWidget#LeftPanel { border-right: 1px solid #232D3A; }
QWidget#RightPanel { border-left: 1px solid #232D3A; }

QLabel#PanelHeader {
    color: #9AA7B6;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 4px 2px;
}

QTreeView#DeviceTree {
    background: transparent;
    border: none;
    color: #C7D2DE;
    show-decoration-selected: 0;
}
QTreeView#DeviceTree::item {
    padding: 6px 4px;
    border-radius: 6px;
    margin: 1px 2px;
}
QTreeView#DeviceTree::item:hover { background: #18202B; }
QTreeView#DeviceTree::item:selected {
    background: rgba(47,129,247,0.18);
    color: #FFFFFF;
}
QTreeView#DeviceTree::branch { background: transparent; }

QSplitter::handle { background: #0B0F14; width: 1px; }

/* ---------------- Video grid & tiles ---------------- */

QWidget#VideoArea { background: #0B0F14; }
QWidget#GridEmpty {
    background: transparent;
    color: #5F6B7A;
}

QWidget#VideoTile {
    background: #0E141B;
    border: 1px solid #232D3A;
    border-radius: 10px;
}
QWidget#VideoTile[selected="true"] {
    border: 2px solid #2F81F7;
    background: #0D1826;
}
QWidget#VideoTile[selected="false"]:hover {
    border: 1px solid #33445A;
}

QWidget#TileHeader {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(8,12,18,0.78), stop:1 rgba(8,12,18,0.0));
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
}
QLabel#TileTitle { color: #E6EDF3; font-size: 12px; font-weight: 600; }
QLabel#TileStatus { font-size: 11px; }

QToolButton#TileBtn {
    background: rgba(14,20,27,0.65);
    border: 1px solid rgba(46,58,73,0.7);
    border-radius: 6px;
    color: #C7D2DE;
    font-size: 12px;
    padding: 1px 5px;
}
QToolButton#TileBtn:hover { background: #2F81F7; border-color: #2F81F7; color: #FFFFFF; }
QToolButton#TileBtn#TileClose:hover { background: #F85149; border-color: #F85149; }

QWidget#TileOverlay { background: #0B0F14; }
QLabel#OverlayText { color: #9AA7B6; font-size: 13px; }
QPushButton#OverlayRetry {
    background: #18202B;
    border: 1px solid #2E3A49;
    border-radius: 7px;
    color: #CFE1FF;
    padding: 6px 16px;
}
QPushButton#OverlayRetry:hover { border-color: #2F81F7; color: #FFFFFF; }

/* ---------------- Control panel (PTZ / preset) ---------------- */

QTabWidget#ControlTabs::pane {
    border: none;
    background: transparent;
}
QTabBar::tab {
    background: #0E141B;
    color: #9AA7B6;
    border: 1px solid #232D3A;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    margin-right: 2px;
    font-size: 12px;
}
QTabBar::tab:selected {
    background: #18202B;
    color: #E6EDF3;
    border-color: #2F81F7;
    font-weight: 600;
}
QTabBar::tab:hover:!selected { color: #E6EDF3; }

QLabel#SectionTitle {
    color: #9AA7B6; font-size: 11px; font-weight: 600;
    letter-spacing: 1px; padding-top: 4px;
}
QLabel#TargetLabel { color: #9AA7B6; font-size: 12px; }
QLabel#TargetLabel[state="ok"] { color: #2ECC71; }
QLabel#TargetLabel[state="bad"] { color: #F85149; }

QToolButton#PtzBtn {
    background: #0E141B;
    border: 1px solid #232D3A;
    border-radius: 9px;
    color: #C7D2DE;
    font-size: 15px;
    min-width: 42px;
    min-height: 38px;
}
QToolButton#PtzBtn:hover { background: #18202B; border-color: #2E3A49; color: #FFFFFF; }
QToolButton#PtzBtn:pressed { background: rgba(47,129,247,0.28); border-color: #2F81F7; }
QToolButton#PtzBtn:disabled { color: #46505C; border-color: #1B2531; }

QToolButton#PtzCenter {
    background: rgba(47,129,247,0.16);
    border: 1px solid #2F81F7;
    border-radius: 9px;
    color: #CFE1FF;
    font-size: 12px;
    font-weight: 600;
    min-width: 42px;
    min-height: 38px;
}
QToolButton#PtzCenter:hover { background: rgba(47,129,247,0.3); color: #FFFFFF; }
QToolButton#PtzCenter:disabled { color: #46505C; border-color: #1B2531; background: #0E141B; }

QPushButton#PresetBtn {
    background: #0E141B;
    border: 1px solid #232D3A;
    border-radius: 8px;
    color: #C7D2DE;
    padding: 7px 10px;
    text-align: left;
}
QPushButton#PresetBtn:hover { border-color: #2F81F7; color: #FFFFFF; }

QPushButton#GhostBtn {
    background: transparent;
    border: 1px solid #2E3A49;
    border-radius: 8px;
    color: #9AA7B6;
    padding: 7px 12px;
}
QPushButton#GhostBtn:hover { border-color: #2F81F7; color: #CFE1FF; }

QSlider::groove:horizontal {
    height: 4px; background: #232D3A; border-radius: 2px;
}
QSlider::sub-page:horizontal { background: #2F81F7; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #E6EDF3; width: 14px; height: 14px;
    margin: -6px 0; border-radius: 7px; border: 2px solid #2F81F7;
}
QSlider::handle:horizontal:hover { background: #FFFFFF; }
QSlider::handle:horizontal:disabled { background: #46505C; border-color: #1B2531; }

QLabel#SpeedValue { color: #CFE1FF; font-size: 12px; }

/* ---------------- Status bar ---------------- */

QStatusBar {
    background: #121821;
    border-top: 1px solid #232D3A;
    color: #9AA7B6;
}
QStatusBar::item { border: none; }

/* ---------------- Toast ---------------- */

QFrame#Toast {
    background: #18202B;
    border: 1px solid #2E3A49;
    border-radius: 10px;
}
QFrame#Toast[kind="success"] { border-left: 3px solid #2ECC71; }
QFrame#Toast[kind="error"]   { border-left: 3px solid #F85149; }
QFrame#Toast[kind="info"]    { border-left: 3px solid #2F81F7; }
QLabel#ToastText { color: #E6EDF3; font-size: 13px; }

/* ---------------- Scrollbars ---------------- */

QScrollBar:vertical {
    background: transparent; width: 10px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: #2E3A49; border-radius: 3px; min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: #3C4B5E; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent; height: 10px; margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #2E3A49; border-radius: 3px; min-width: 28px;
}
QScrollBar::handle:horizontal:hover { background: #3C4B5E; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
