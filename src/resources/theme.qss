/* =====================================================================
   zero-player · theme.qss (template)
   Placeholders like %accent% are substituted by ThemeManager at runtime
   with values from the active ThemeTokens (light/dark). Do NOT hardcode
   colors here.
   ===================================================================== */

* {
    font-family: %fontFamily%;
    outline: none;
}

QWidget {
    color: %text%;
    font-size: 13px;
}

QToolTip {
    background: %bgElevated%;
    color: %text%;
    border: 1px solid %borderStrong%;
    padding: 4px 8px;
    border-radius: 6px;
}

/* ---------------- Login ---------------- */

QWidget#LoginRoot {
    background: %bgRoot%;
}

QFrame#LoginCard {
    background: %bgPanel%;
    border: 1px solid %border%;
    border-radius: 20px;
}

QWidget#BrandPanel {
    background: %bgInput%;
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
    border-right: 1px solid %border%;
}

QLabel#BrandName { color: %text%; font-size: 30px; font-weight: 800; letter-spacing: 0.5px; }
QLabel#BrandSub  { color: %text2%; font-size: 13px; letter-spacing: 3px; }
QLabel#BrandFoot { color: %muted%; font-size: 11px; letter-spacing: 0.5px; }

QWidget#FormPanel { background: transparent; }
QLabel#FormTitle { color: %text%; font-size: 21px; font-weight: 700; }
QLabel#FormSubtitle { color: %muted%; font-size: 12.5px; }

QLineEdit#IconInput {
    background: transparent;
    border: none;
    color: %text%;
    selection-background-color: %accent%;
    padding: 0;
}

QWidget#IconField {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 11px;
}
QWidget#IconField[focused="true"] {
    border: 1px solid %accent%;
    background: %bgPanel%;
}

QPushButton#LoginButton {
    background: %accent%;
    color: #FFFFFF;
    border: none;
    border-radius: 11px;
    padding: 12px 16px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 4px;
}
QPushButton#LoginButton:hover { background: %accent2%; }
QPushButton#LoginButton:disabled { background: %borderStrong%; color: %muted%; }

QLabel#ErrorLabel { color: %danger%; font-size: 12px; min-height: 15px; }

QToolButton#FormClose {
    background: transparent;
    border: none;
    border-radius: 9px;
    color: %muted%;
    font-size: 15px;
}
QToolButton#FormClose:hover { background: %dangerSoft%; color: %danger%; }

QToolButton#ServerCfg {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 8px;
    color: %text2%;
    padding: 6px 10px;
    font-size: 12.5px;
}
QToolButton#ServerCfg:hover { border-color: %accent%; color: %accent%; }

QCheckBox { color: %text2%; spacing: 8px; font-size: 12.5px; }
QCheckBox::indicator {
    width: 17px; height: 17px;
    border: 1.5px solid %borderStrong%;
    border-radius: 5px;
    background: %bgPanel%;
}
QCheckBox::indicator:hover { border-color: %accent%; }
QCheckBox::indicator:checked {
    /* Filled accent state: stays unmistakably "on" even on machines where the
       SVG check glyph fails to render (missing image plugin / partial Qt
       deployment), which otherwise looks like the checkbox does nothing. */
    background: %accent%;
    border-color: %accent%;
    image: url(:/resources/check.svg);
}

/* ---------------- Player window ---------------- */

QMainWindow#PlayerWindow { background: %bgRoot%; }
/* Frameless window, but no decorative outline: the one-pixel region dividers
   are drawn by the splitter handles and the top/bottom bars themselves, so
   edges meet exactly instead of producing a double-line/stepped border. */
QWidget#RootArea {
    background: %bgRoot%;
    border: none;
}

QWidget#TitleBar {
    background: %bgPanel%;
    border-bottom: 1px solid %borderStrong%;
}
QWidget#LayoutBar {
    background: %bgPanel%;
    border-bottom: 1px solid %divider%;
}
/* 资源目录视图切换（行政区划 / 业务分组） */
QWidget#TreeViewTabs { background: %bgRoot%; }
QToolButton#TreeViewTab {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 7px;
    color: %text2%;
    font-size: 11.5px;
    padding: 5px 2px;
}
QToolButton#TreeViewTab:hover { color: %text%; border-color: %borderStrong%; }
QToolButton#TreeViewTab:checked {
    background: %accentSoft%;
    border-color: %accent%;
    color: %accent%;
    font-weight: 600;
}
/* 在线通道数：12px 胶囊徽章，数字高亮，和标题垂直居中对齐。 */
QLabel#TreeCount {
    color: %text2%;
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 600;
}
/* 回放检索抽屉：左栏底部，与资源树用细分隔线隔开。 */
QWidget#PlaybackFilter {
    background: %bgInput%;
    border-top: 1px solid %divider%;
}
QLabel#PlaybackFilterLabel {
    color: %text2%;
    font-size: 13px;
}
/* 一级模式 Tab（实时预览 / 录像回放）由 ModeTabBar 自绘。 */
QWidget#ModeTabBar { background: %bgPanel%; border-bottom: 1px solid %divider%; }
QLabel#AppName { color: %text%; font-size: 15.5px; font-weight: 800; letter-spacing: 0.3px; }

/* 回放空状态：说明当前状态与下一步操作。 */
QFrame#PbEmptyState {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 8px;
}
QLabel#PbEmptyIcon { color: %muted%; font-size: 26px; }
QLabel#PbEmptyTitle { color: %text2%; font-size: 12px; font-weight: 600; }
QLabel#PbEmptyHint { color: %muted%; font-size: 11px; }

QLineEdit#SearchBox {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 10px;
    padding: 7px 12px;
    color: %text%;
    selection-background-color: %accent%;
}
QLineEdit#SearchBox:focus { border-color: %accent%; background: %bgPanel%; }

QPushButton#SegItem {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 8px;
    color: %text2%;
    text-align: left;
    padding: 8px 11px;
    font-size: 11.5px;
    font-family: %monoFamily%;
}
QPushButton#SegItem:hover { border-color: %accentSoft2%; background: %bgHover%; color: %text%; }
QPushButton#SegItem:checked {
    background: %accentSoft%;
    border-color: %accent%;
    color: %accent%;
    font-weight: 600;
}

QToolButton#LayoutBtn {
    background: transparent;
    border: 1px solid %border%;
    border-radius: 8px;
    color: %text2%;
    font-size: 12px;
    font-weight: 700;
    min-width: 40px;
    min-height: 30px;
}
QToolButton#LayoutBtn:hover { color: %accent%; background: %bgHover%; border-color: %accentSoft2%; }
QToolButton#LayoutBtn:checked {
    background: %accentSoft%;
    border-color: %accent%;
    color: %accent%;
}

QToolButton#ToolChip {
    background: %bgPanel%;
    border: 1px solid %border%;
    border-radius: 9px;
    color: %text2%;
    min-width: 34px; min-height: 34px;
}
QToolButton#ToolChip:hover { border-color: %accent%; color: %accent%; }

QToolButton#IconBtn {
    background: transparent;
    border: none;
    border-radius: 9px;
    color: %text2%;
    min-width: 34px; min-height: 34px;
}
QToolButton#IconBtn:hover { background: %bgInput%; color: %accent%; }

QToolButton#WinBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
}
QToolButton#WinBtn:hover { background: %bgInput%; }
QToolButton#WinClose {
    background: transparent;
    border: none;
    border-radius: 8px;
}
QToolButton#WinClose:hover { background: rgba(229, 72, 77, 0.16); }

QToolButton#UserBtn {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 16px;
    color: %text%;
    padding: 4px 14px 4px 6px;
}
QToolButton#UserBtn:hover { border-color: %accent%; }
QToolButton#UserBtn::menu-indicator { image: none; }

QMenu {
    background: %bgElevated%;
    border: 1px solid %border%;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item { padding: 8px 20px; border-radius: 7px; color: %text%; }
QMenu::item:selected { background: %accentSoft2%; }
QMenu::separator { height: 1px; background: %divider%; margin: 5px 8px; }

/* ---------------- Panels ---------------- */

QWidget#SidePanel { background: %bgPanel%; }
/* LeftPanel is also the object name of the resource-tree body; it must not
   paint an edge — the splitter handle is the single divider. */
QWidget#LeftPanel { background: %bgPanel%; }
QWidget#LeftSidebar { background: %bgPanel%; }
QWidget#RightSidebar { background: %bgPanel%; }

QLabel#PanelTitle { color: %text%; font-size: 12.5px; font-weight: 700; }
QWidget#PanelHeaderBar { background: %bgPanel%; border-bottom: 1px solid %divider%; }
QLabel#PanelHeaderTitle { color: %text%; font-size: 12.5px; font-weight: 700; }

QTreeView#DeviceTree {
    background: transparent;
    border: none;
    color: %text%;
}
QTreeView#DeviceTree::item {
    padding: 6px 4px;
    border-radius: 8px;
    margin: 1px 2px;
}
QTreeView#DeviceTree::item:hover { background: %bgHover%; }
/* Selection is shown with accent text only — no filled block behind the row. */
QTreeView#DeviceTree::item:selected,
QTreeView#DeviceTree::item:selected:hover,
QTreeView#DeviceTree::item:pressed {
    background: transparent;
    color: %accent%;
}
QTreeView#DeviceTree::branch { background: transparent; }

/* Right tool dock: PTZ + local failed samples share one tabbed panel. */
QTabWidget#ToolDock {
    background: %bgPanel%;
    border: none;
    outline: none;
}
QTabWidget#ToolDock::pane {
    border: none;
    background: %bgPanel%;
}
QTabWidget#ToolDock QTabBar {
    background: %bgPanel%;
    border-bottom: 1px solid %divider%;
}
QTabWidget#ToolDock QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: %text2%;
    padding: 10px 16px;
    font-size: 12.5px;
    min-height: 40px;
}
QTabWidget#ToolDock QTabBar::tab:hover { color: %accent%; }
QTabWidget#ToolDock QTabBar::tab:selected {
    color: %accent%;
    border-bottom: 2px solid %accent%;
    font-weight: 600;
}
QTabWidget#ToolDock QTabBar::tab:disabled { color: %muted%; }

/* ---- Product UI cards (redisign) ---- */
QListWidget#SampleCards {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#SampleCards::item {
    background: %bgPanel%;
    border: 1px solid %border%;
    border-radius: 8px;
    padding: 8px 10px;
    margin: 3px 2px;
    color: %text%;
    font-size: 12px;
}
QListWidget#SampleCards::item:hover { border-color: %accent%; }
QListWidget#SampleCards::item:selected {
    background: %accentSoft%;
    border-color: %accent%;
    color: %accent%;
}

/* Queue as a clean table */
QTableWidget#QueueTable {
    background: %bgPanel%;
    border: 1px solid %border%;
    border-radius: 10px;
    gridline-color: %divider%;
    selection-background-color: %accentSoft%;
    selection-color: %text%;
    outline: none;
}
QTableWidget#QueueTable::item {
    padding: 7px 8px;
    border-bottom: 1px solid %divider%;
}
QTableWidget#QueueTable QHeaderView::section {
    background: %bgInput%;
    color: %text2%;
    border: none;
    border-bottom: 1px solid %border%;
    padding: 7px 8px;
    font-weight: 700;
    font-size: 11px;
}

/* Training progress + dark console */
QProgressBar#TrainProgress {
    border: 1px solid %border%;
    border-radius: 6px;
    background: %bgInput%;
    height: 12px;
    text-align: center;
    font-size: 10px;
    color: %text2%;
}
QProgressBar#TrainProgress::chunk {
    background: %accent%;
    border-radius: 6px;
}
QPlainTextEdit#TrainLog {
    background: transparent;
    color: #CBD5E1;
    border: none;
    font-family: %monoFamily%;
    font-size: 11.5px;
    padding: 0;
    selection-background-color: #1E40AF;
}
QFrame#KpiCard {
    background: %bgPanel%;
    border: 1px solid %border%;
    border-radius: 10px;
}
QLabel#KpiTitle { color: %text2%; font-size: 11px; font-weight: 600; }
QLabel#KpiValue { color: %text%; font-size: 20px; font-weight: 700; }

/* Publish export-format cards */
QFrame#FmtCard, QFrame#FmtCardOn {
    border-radius: 10px;
}
QFrame#FmtCard {
    background: %bgPanel%;
    border: 1px solid %border%;
}
QFrame#FmtCardOn {
    background: %accentSoft%;
    border: 2px solid %accent%;
}
QLabel#FmtTitle { color: %text%; font-size: 12.5px; font-weight: 700; }
QLabel#FmtSub { color: %text2%; font-size: 11px; }

/* Training command box + console header */
QLineEdit#CmdBox {
    background: #0B1220;
    color: #CBD5E1;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 7px 10px;
    font-family: %monoFamily%;
    font-size: 12px;
}
QLabel#ConsoleHeader {
    color: %text2%;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 2px 2px 0 2px;
}

/* Version list as cards */
QListWidget#VersionList {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#VersionList::item {
    background: %bgPanel%;
    border: 1px solid %border%;
    border-radius: 8px;
    padding: 9px 11px;
    margin: 3px 2px;
    color: %text%;
    font-size: 12px;
}
QListWidget#VersionList::item:hover { border-color: %accent%; }
QListWidget#VersionList::item:selected {
    background: %accentSoft%;
    border-color: %accent%;
    color: %accent%;
}

/* The one and only vertical divider between left / center / right.
   No margins, no grip dots — just a continuous 1px line. */
QSplitter#BodySplitter::handle {
    background: %borderStrong%;
    margin: 0;
    padding: 0;
    border: none;
}

/* ---------------- Video grid & tiles ---------------- */

QWidget#VideoArea { background: %bgRoot%; }
QWidget#GridEmpty { background: transparent; }
/* 空窗格占位：未选通道时先把分屏格子画出来。 */
QWidget#GridEmptySlot {
    background: %bgRoot%;
    border: 1px solid %border%;
    border-radius: 6px;
}
QLabel#GridEmptySlotHint { color: %muted%; font-size: 11px; }
/* Grid divider: the host background shows through the inter-cell gaps.
   Same one-pixel skeleton color as the region dividers. */
QWidget#GridHost { background: %borderStrong%; }

/* VideoTile is a QWidget subclass, so Qt does not paint stylesheet borders or
   backgrounds on it (WA_StyledBackground stays off for subclasses). The active
   tile is therefore marked by an overlay ring painted above the picture. */
QWidget#VideoTile { background: transparent; }

QFrame#TileSelectionRing {
    background: transparent;
    border: 2px solid %accent%;
    border-radius: 6px;
}

QWidget#TileFooter {
    background: %bgPanel%;
    border-top: 1px solid %divider%;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Floating transport pill and docked action bar over the video.
   The transport pill floats over the picture, so it stays translucent to avoid
   blocking the view; the docked action bar stays opaque and covers the
   letterbox strip at the bottom. */
QWidget#TileBar {
    background: rgba(16, 18, 22, 120);
    border: 1px solid rgba(255, 255, 255, 22);
    border-radius: 10px;
}
/* Docked action bar: full width, flush to the bottom edge, square corners so
   it reads as one standalone strip fully covering the letterbox below. */
QWidget#TileBar[dock="bottom"] {
    background: #16191E;
    border: none;
    border-radius: 0;
}
/* 顶部 AI 分析条：半透明玻璃，悬停窗格时由代码提升不透明度。 */
QWidget#TileAiBar {
    background: rgba(12, 16, 24, 150);
    border: 1px solid rgba(255, 255, 255, 35);
    border-radius: 8px;
}
QWidget#TileAiBar[hovered="true"] {
    background: rgba(12, 16, 24, 235);
    border: 1px solid rgba(255, 255, 255, 65);
}
QToolButton#BarBtn, QToolButton#BarPlay {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #C7CDD4;
    font-size: 12px;
    padding: 3px 8px;
}
QToolButton#BarBtn:hover, QToolButton#BarPlay:hover {
    background: rgba(255, 255, 255, 18);
    color: #FFFFFF;
}
QToolButton#BarBtn:pressed, QToolButton#BarPlay:pressed {
    background: rgba(255, 255, 255, 30);
}
QToolButton#BarBtn:checked {
    color: #8AB4F8;
    background: rgba(138, 180, 248, 30);
}
QToolButton#BarBtn:disabled { color: rgba(199, 205, 212, 80); }
QToolButton#BarBtn[role="close"]:hover { background: #C0392B; color: #FFFFFF; }
QLabel#BarName { color: #E6EAF0; font-size: 11.5px; font-weight: 600; }
QFrame#BarDot { background: #2ECC71; border-radius: 3px; }
QToolButton#BarPlay { padding: 3px 5px; }
/* Visible caret for buttons that open a menu (AI 检查 / 播放速度). */
QToolButton#BarBtn::menu-button {
    border: none;
    width: 13px;
}
QToolButton#BarBtn::menu-arrow {
    image: url(:/resources/chevron-down.svg);
    width: 9px;
    height: 9px;
}
QToolButton#BarBtn::menu-indicator {
    image: url(:/resources/chevron-down.svg);
    width: 9px;
    height: 9px;
    subcontrol-position: right center;
    right: 3px;
}
QLabel#BarTime {
    color: #9AA3AD;
    font-size: 12px;
    padding: 0 2px;
}
QFrame#BarSep { color: rgba(255, 255, 255, 26); }

QSlider#BarSeek { background: transparent; }
QSlider#BarSeek::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 34);
}
QSlider#BarSeek::sub-page:horizontal {
    background: %accent%;
    border-radius: 2px;
}
QSlider#BarSeek::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
    background: #FFFFFF;
}

QToolButton#TileBtn {
    background: %bgPanel%;
    border: 1px solid %border%;
    border-radius: 7px;
    color: %text2%;
    font-size: 12px;
    padding: 1px 5px;
}
QToolButton#TileBtn:hover { background: %accent%; border-color: %accent%; color: #FFFFFF; }
QToolButton#TileBtn[role="close"]:hover { background: %danger%; border-color: %danger%; }

QWidget#TileOverlay { background: %videoBg%; }
QLabel#OverlayText { color: %text2%; font-size: 13px; }
QPushButton#OverlayRetry {
    background: %bgPanel%;
    border: 1px solid %borderStrong%;
    border-radius: 8px;
    color: %accent%;
    padding: 6px 16px;
}
QPushButton#OverlayRetry:hover { border-color: %accent%; }

/* ---------------- Control panel ---------------- */

QLabel#SectionTitle {
    color: %text2%; font-size: 11px; font-weight: 700; letter-spacing: 0.8px;
}
QLabel#TargetLabel { color: %text2%; font-size: 12px; }
QLabel#TargetLabel[state="ok"] { color: %success%; }
QLabel#TargetLabel[state="bad"] { color: %danger%; }
/* 能力说明：内联浅色提示，不抢焦点也不使用告警红。 */
QLabel#PtzNotice {
    color: %muted%;
    font-size: 11.5px;
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 6px;
}

/* PTZ directional pad */
QToolButton#PtzDirBtn {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 9px;
    color: %text2%;
    font-size: 15px;
    font-weight: 600;
    min-width: 42px;
    min-height: 42px;
}
QToolButton#PtzDirBtn:hover { border-color: %accent%; color: %accent%; background: %bgHover%; }
QToolButton#PtzDirBtn:pressed { background: %accentSoft%; border-color: %accent%; color: %accent%; }
QToolButton#PtzDirBtn:disabled { color: %muted%; border-color: %border%; background: %bgInput%; }

/* PTZ tab bar (预置位 / 巡航 / 守望) */
QTabBar#PtzTabs { background: transparent; }
QTabBar#PtzTabs::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: %text2%;
    padding: 7px 14px;
    font-size: 12.5px;
}
QTabBar#PtzTabs::tab:hover { color: %accent%; }
QTabBar#PtzTabs::tab:selected { color: %accent%; border-bottom: 2px solid %accent%; font-weight: 600; }

/* Preset list */
QListWidget#PresetList {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 9px;
    outline: none;
    padding: 4px;
}
QListWidget#PresetList::item {
    color: %text2%;
    padding: 7px 10px;
    border-radius: 6px;
}
QListWidget#PresetList::item:hover { background: %bgHover%; color: %text%; }
QListWidget#PresetList::item:selected { background: %accentSoft%; color: %accent%; }

QToolButton#GhostBtn {
    background: transparent;
    border: 1px solid %border%;
    border-radius: 9px;
    color: %text2%;
    padding: 6px 12px;
}
QToolButton#GhostBtn:hover { border-color: %accent%; color: %accent%; }

QPushButton#GhostBtn {
    background: transparent;
    border: 1px solid %border%;
    border-radius: 9px;
    color: %text2%;
    padding: 7px 12px;
}
QPushButton#GhostBtn:hover { border-color: %accent%; color: %accent%; }

QSlider::groove:horizontal { height: 4px; background: %border%; border-radius: 2px; }
QSlider::sub-page:horizontal { background: %accent%; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #FFFFFF; width: 15px; height: 15px;
    margin: -6px 0; border-radius: 7px; border: 2px solid %accent%;
}
QSlider::handle:horizontal:hover { background: %bgHover%; }
QSlider::handle:horizontal:disabled { background: %border%; border-color: %muted%; }

QLabel#SpeedValue { color: %accent%; font-size: 12px; font-weight: 700; }

/* ---------------- Status bar ---------------- */

QStatusBar {
    background: %bgPanel%;
    border-top: 1px solid %borderStrong%;
    color: %muted%;
    min-height: 28px;
    max-height: 28px;
}
QStatusBar::item { border: none; }
QLabel#StatusBarMessage { color: %muted%; font-size: 11px; padding: 0 6px; }
QLabel#StatusBarMessage[kind="info"]    { color: %text2%; }
QLabel#StatusBarMessage[kind="success"] { color: %success%; }
QLabel#StatusBarMessage[kind="error"]   { color: %warning%; }

/* ---------------- Toast ---------------- */

QFrame#Toast {
    background: %bgElevated%;
    border: 1px solid %border%;
    border-radius: 8px;
}
/* Subtle 2px accent edge — informative, not alarming. */
QFrame#Toast[kind="success"] { border-left: 2px solid %success%; }
QFrame#Toast[kind="error"]   { border-left: 2px solid %warning%; }
QFrame#Toast[kind="info"]    { border-left: 2px solid %accent%; }
QLabel#ToastText { color: %text%; font-size: 12px; }

/* ---------------- Scrollbars ---------------- */

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: %borderStrong%; border-radius: 3px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: %muted%; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: %borderStrong%; border-radius: 3px; min-width: 28px; }
QScrollBar::handle:horizontal:hover { background: %muted%; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------------- Settings dialog ---------------- */

QDialog#SettingsDialog {
    background: %bgPanel%;
}

/* Category nav list on the left */
QListWidget#SettingsNav {
    background: %bgRoot%;
    border: 1px solid %border%;
    border-radius: 10px;
    outline: none;
    padding: 6px;
}
QListWidget#SettingsNav::item {
    color: %text2%;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 13px;
}
QListWidget#SettingsNav::item:hover { background: %bgHover%; color: %text%; }
QListWidget#SettingsNav::item:selected {
    background: %accentSoft%;
    color: %accent%;
    font-weight: 600;
}

QLabel#VsGroupTitle {
    color: %accent%;
    font-size: 12px;
    font-weight: 700;
    padding-top: 4px;
}
QLabel#VsFieldLabel { color: %text2%; font-size: 12px; }
QLabel#VsValue { color: %text%; font-size: 12px; font-weight: 600; min-width: 34px; }
QLabel#VsHint { color: %muted%; font-size: 11px; }

QComboBox#VsCombo {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 8px;
    padding: 6px 10px;
    color: %text%;
    min-height: 28px;
}
QComboBox#VsCombo:hover { border-color: %borderStrong%; }
QComboBox#VsCombo:focus { border-color: %accent%; }
QComboBox#VsCombo::drop-down { border: none; width: 22px; }
QComboBox#VsCombo QAbstractItemView {
    background: %bgElevated%;
    border: 1px solid %border%;
    border-radius: 8px;
    color: %text%;
    selection-background-color: %accentSoft%;
    selection-color: %accent%;
    outline: none;
}

/* Evidence review dialog */
QDialog#EvidenceDialog { background: %bgPanel%; }
QLabel#DialogTitle { color: %text%; font-size: 15px; font-weight: 600; }
QListWidget#EvidenceList {
    background: %bgRoot%;
    border: 1px solid %border%;
    border-radius: 10px;
    outline: none;
}
QListWidget#EvidenceList::item { border-bottom: 1px solid %divider%; }
QLabel#EvidenceThumb {
    background: %videoBg%;
    border: 1px solid %border%;
    border-radius: 6px;
    color: %muted%;
    font-size: 11px;
}
QLabel#EvidenceInfo { color: %text2%; font-size: 12px; line-height: 150%; }
QLabel#EvidenceSummary { color: %muted%; font-size: 11.5px; }
QPushButton#PrimaryButton {
    background: %accent%;
    border: none;
    border-radius: 7px;
    color: #FFFFFF;
    padding: 7px 18px;
    font-weight: 600;
}
QPushButton#PrimaryButton:hover { background: %accentSoft2%; }

/* One-time usage hint floating over the video (auto-dismisses) */
QLabel#VideoHint {
    background: rgba(10, 14, 20, 165);
    color: #E6EDF3;
    border-radius: 9px;
    padding: 6px 14px;
    font-size: 12px;
}

/* =====================================================================
   AI 样本采集 / 标注 / 训练闭环  (docs/zeroo_ai_prototype)
   ===================================================================== */

/* ---- soft status chips ---- */
QLabel#Chip {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#Chip[kind="ok"]    { background: %successSoft%; color: %success%; }
QLabel#Chip[kind="warn"]  { background: %warningSoft%; color: %warning%; }
QLabel#Chip[kind="bad"]   { background: %dangerSoft%;  color: %danger%; }
QLabel#Chip[kind="info"]  { background: %accentSoft%;  color: %accent%; }
QLabel#Chip[kind="muted"] { background: %bgInput%; color: %muted%; border-color: %border%; }
QLabel#Chip[mono="true"]  { font-family: %monoFamily%; }

/* ---- player right dock: sample cards ---- */
QScrollArea#SampleScroll { background: transparent; border: none; }
QScrollArea#SampleScroll > QWidget > QWidget { background: transparent; }
QWidget#SampleListHost { background: transparent; }
QLabel#SampleEmpty { color: %muted%; font-size: 12px; }

QFrame#SampleCard {
    background: %bgPanel%;
    border: 1px solid %border%;
    border-radius: 8px;
}
QFrame#SampleCard:hover { border-color: %accent%; }
QFrame#SampleCard[done="true"] { background: %bgRoot%; }
QLabel#SampleName {
    color: %text%;
    font-family: %monoFamily%;
    font-size: 12px;
    font-weight: 700;
}
QLabel#SampleName[done="true"] { color: %muted%; font-weight: 600; }

/* ---- training workbench ---- */
QDialog#TrainingTool { background: %bgRoot%; }

QWidget#TrainNav {
    background: %bgPanel%;
    border-right: 1px solid %border%;
}
QPushButton#NavItem {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: %text2%;
    padding: 8px 10px;
    text-align: left;
    font-size: 12.5px;
}
QPushButton#NavItem:hover { background: %bgHover%; color: %text%; }
QPushButton#NavItem:checked { background: %accentSoft%; color: %accent%; font-weight: 600; }
QLabel#NavBadge {
    background: %accentSoft2%;
    color: %accent%;
    border-radius: 8px;
    padding: 1px 6px;
    font-family: %monoFamily%;
    font-size: 10px;
    font-weight: 700;
}
QLabel#NavDot {
    background: %success%;
    border-radius: 3px;
    min-width: 6px; max-width: 6px;
    min-height: 6px; max-height: 6px;
}
QFrame#NavFooter {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 8px;
}
QLabel#NavFootKey { color: %muted%; font-size: 10px; }
QLabel#NavFootVal {
    color: %text2%;
    font-family: %monoFamily%;
    font-size: 11px;
    font-weight: 600;
}

QFrame#PanelCard {
    background: %bgPanel%;
    border: 1px solid %border%;
    border-radius: 10px;
}
QLabel#PageTitle { color: %text%; font-size: 14px; font-weight: 700; }
QLabel#PageSub   { color: %muted%; font-size: 11px; font-family: %monoFamily%; }
QLabel#CardTitle { color: %text%; font-size: 12px; font-weight: 700; }
QLabel#FieldLabel { color: %text2%; font-size: 11px; font-weight: 600; }
QLabel#MonoValue { color: %text%; font-family: %monoFamily%; font-size: 12px; font-weight: 600; }

/* inputs */
QLineEdit#SearchInput {
    background: %bgPanel%;
    border: 1px solid %border%;
    border-radius: 8px;
    padding: 6px 10px;
    color: %text%;
    font-size: 12px;
}
QLineEdit#SearchInput:focus { border-color: %accent%; }
QSpinBox#ParamBox, QLineEdit#ParamBox, QComboBox#ParamCombo {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 6px;
    padding: 5px 8px;
    color: %text%;
    font-family: %monoFamily%;
    font-size: 12px;
    font-weight: 600;
}
QSpinBox#ParamBox:focus, QLineEdit#ParamBox:focus, QComboBox#ParamCombo:focus {
    border-color: %accent%;
}
QComboBox#ParamCombo::drop-down { border: none; width: 20px; }
QComboBox#ParamCombo QAbstractItemView {
    background: %bgElevated%;
    border: 1px solid %border%;
    border-radius: 6px;
    color: %text%;
    selection-background-color: %accentSoft%;
    selection-color: %accent%;
    outline: none;
}
QLineEdit#CmdBox {
    background: #0B1220;
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 7px 10px;
    color: #CBD5E1;
    font-family: %monoFamily%;
    font-size: 11px;
    selection-background-color: #1E40AF;
}

/* dark training console */
QFrame#ConsoleCard {
    background: #0B1220;
    border: 1px solid #1E293B;
    border-radius: 10px;
}
QLabel#ConsoleHead {
    color: #64748B;
    font-family: %monoFamily%;
    font-size: 10px;
}
QLabel#ConsoleBadge[idle="true"]  { color: #64748B; font-family: %monoFamily%; font-size: 10px; }
QLabel#ConsoleBadge[idle="false"] { color: #34D399; font-family: %monoFamily%; font-size: 10px; font-weight: 700; }

/* annotation page */
QWidget#AnnoBar {
    background: %bgPanel%;
    border-bottom: 1px solid %border%;
}
QLabel#AnnoName {
    color: %text%;
    font-family: %monoFamily%;
    font-size: 12px;
    font-weight: 700;
}
QLabel#AnnoIndex { color: %text2%; font-family: %monoFamily%; font-size: 11px; }
QWidget#AnnoInspector {
    background: %bgPanel%;
    border-left: 1px solid %border%;
}
QListWidget#BoxList {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 8px;
    outline: none;
    padding: 3px;
}
QListWidget#BoxList::item {
    color: %text2%;
    padding: 5px 7px;
    border-radius: 6px;
    font-size: 11.5px;
}
QListWidget#BoxList::item:hover { background: %bgHover%; color: %text%; }
QListWidget#BoxList::item:selected { background: %accentSoft%; color: %accent%; }
QToolButton#ClassBtn {
    background: %bgInput%;
    border: 1px solid %border%;
    border-radius: 6px;
    color: %text2%;
    padding: 5px 8px;
    font-size: 11px;
    text-align: left;
}
QToolButton#ClassBtn:hover { border-color: %accent%; color: %accent%; }
QToolButton#ClassBtn:checked {
    background: %accent%;
    border-color: %accent%;
    color: #FFFFFF;
    font-weight: 700;
}
QPushButton#LinkBtn {
    background: transparent;
    border: none;
    color: %accent%;
    font-size: 11px;
    padding: 0;
}
QPushButton#LinkBtn:hover { color: %accent2%; }

/* thin distribution / comparison bars (chunk colour set inline) */
QProgressBar#DistBar {
    background: %bgInput%;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}
QProgressBar#DistBar::chunk { border-radius: 4px; }
QWidget#AnnoFoot {
    background: %bgPanel%;
    border-top: 1px solid %border%;
}
QComboBox#ParamCombo::down-arrow {
    image: url(:/resources/chevron-down.svg);
    width: 10px;
    height: 10px;
}
QComboBox#ParamCombo::down-arrow:on { image: url(:/resources/chevron-down.svg); }

/* Collapsed right dock: slim vertical strip that re-opens the panel */
QToolButton#DockReopen {
    background: %bgPanel%;
    border: none;
    color: %text2%;
    font-weight: 700;
}
QToolButton#DockReopen:hover { background: %accentSoft%; color: %accent%; }
