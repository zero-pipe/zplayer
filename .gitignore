# build outputs
/build/
/out/
/zplayer/

# vendored 3rd-party runtimes (large; only headers/.pri/.lib are tracked).
# qtav-sdk is x86-only and unused in the x64 mainline -> ignored wholesale.
/3rdpart/qtav-sdk/
/3rdpart/mpv-sdk/bin/

# qmake / IDE
*.user
*.user.*
.qmake.stash
.qmake.cache
config.log
Makefile*
*.pro.autosave
.vscode/

# local build config (per-machine toolchain paths; see build.local.bat.example)
/build.local.bat

# runtime artifacts
*.log

# objects
*.o
*.obj
*.moc
moc_*.cpp
qrc_*.cpp
ui_*.h
# ...except the hand-written widget kit (not a Qt Designer form)
!src/ui/ui_kit.h

# binaries
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk

# mpv SDK: keep the (small) import library so the app links without the
# 184 MB runtime DLL set; the bin/x64 DLLs stay untracked on purpose.
!/3rdpart/mpv-sdk/lib/**/*.lib
/3rdpart/models
/3rdpart/onnxruntime
# 本地 AI 引导文件，不入库（保留本地）
Claude.md
CLAUDE.md
